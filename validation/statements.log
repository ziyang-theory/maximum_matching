                                              p.vertex K = v
@MaximumMatching.Search.BudGraphInvariant.current_bridge_graph_arms : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
  cut % 2 = 1 →
    MaximumMatching.AtMostShortestAugmenting M (cut + 2) →
      MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
        cut + 2 ≤ 2 * cap + 1 →
          ∀ (p : MaximumMatching.AltPath M),
            MaximumMatching.tenacity M p.last = some (cut + 2) →
              MaximumMatching.maxlevel M p.last = some p.length →
                ∀ (I : Fin p.length),
                  MaximumMatching.Bridge M (p.vertex ⟨↑I, ⋯⟩) (p.vertex ⟨↑I + 1, ⋯⟩) →
                    MaximumMatching.edgeTenacity M (p.vertex ⟨↑I, ⋯⟩) (p.vertex ⟨↑I + 1, ⋯⟩) = some (cut + 2) →
                      (∃ k, s.minLabel (p.vertex ⟨↑I, ⋯⟩) = some k) →
                        (∃ k, s.minLabel (p.vertex ⟨↑I + 1, ⋯⟩) = some k) →
                          ∃ a b,
                            a.first = F.root (p.vertex ⟨↑I, ⋯⟩) ∧
                              a.last = p.first ∧
                                b.first = F.root (p.vertex ⟨↑I + 1, ⋯⟩) ∧
                                  b.last = p.last ∧
                                    a.Disjoint b ∧ (MaximumMatching.Search.predecessorGraph s F h).level a.last = 0
@MaximumMatching.Search.BudGraphInvariant.support_graph_arms : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
  cut % 2 = 1 →
    MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
      cut + 2 ≤ 2 * cap + 1 →
        ∀ (u v w : V),
          MaximumMatching.edgeTenacity M u v = some (cut + 2) →
            (∃ k, s.minLabel u = some k) →
              (∃ k, s.minLabel v = some k) →
                MaximumMatching.InSupport M u v w →
                  ∃ p q,
                    p.last = w ∧
                      (MaximumMatching.Search.predecessorGraph s F h).level q.last = 0 ∧
                        p.Disjoint q ∧
                          (p.first = F.root u ∧ q.first = F.root v ∨ p.first = F.root v ∧ q.first = F.root u)
@MaximumMatching.Search.BudGraphInvariant.support_in_bottleneck_region : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
  cut % 2 = 1 →
    MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
      cut + 2 ≤ 2 * cap + 1 →
        ∀ (u v w b : V),
          MaximumMatching.edgeTenacity M u v = some (cut + 2) →
            (∃ k, s.minLabel u = some k) →
              (∃ k, s.minLabel v = some k) →
                MaximumMatching.DDFS.Bottleneck (MaximumMatching.Search.predecessorGraph s F h) (F.root u) (F.root v)
                    b →
                  MaximumMatching.InSupport M u v w → MaximumMatching.DDFS.OnRootTo (F.root u) (F.root v) b w ∧ w ≠ b
@MaximumMatching.Search.CurrentBridgeRepresentation.ofLowerBlossoms : {V : Type} →
  [inst : DecidableEq V] →
    {G : MaximumMatching.Graph V} →
      {M : MaximumMatching.Matching G} →
        {cap cut : Nat} →
          {s : MaximumMatching.Search.State V} →
            {F : MaximumMatching.BudForest V} →
              (h : MaximumMatching.Search.BudGraphInvariant M cap s F) →
                cut % 2 = 1 →
                  (∀ (p : MaximumMatching.AltPath M), p.Augmenting → cut < p.length) →
                    2 * cap ≤ cut + 3 →
                      cut ≤ 2 * cap + 1 →
                        MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
                          MaximumMatching.Search.CurrentBridgeRepresentation M cut h
@MaximumMatching.Search.PetalRecord.afterBridgeRepresentation : {n : Nat} →
  {G : MaximumMatching.Graph (Fin n)} →
    {M : MaximumMatching.Matching G} →
      {cut : Nat} →
        (R : MaximumMatching.Search.PetalRecord M) →
          MaximumMatching.Search.CurrentBridgeRepresentation M cut ⋯ →
            MaximumMatching.Search.CurrentBridgeRepresentation M cut ⋯
@MaximumMatching.Search.CurrentBridgeRepresentation.execute_output_sound : ∀ {n : Nat}
  {G : MaximumMatching.Graph (Fin n)} {M : MaximumMatching.Matching G} {cap cut : Nat}
  {s : MaximumMatching.Search.State (Fin n)} {F : MaximumMatching.BudForest (Fin n)}
  {h : MaximumMatching.Search.BudGraphInvariant M cap s F}
  (P : MaximumMatching.Search.CurrentBridgeRepresentation M cut h),
  cut % 2 = 1 →
    MaximumMatching.AtMostShortestAugmenting M (cut + 2) →
      ∀ (u v : Fin n),
        MaximumMatching.Bridge M u v →
          MaximumMatching.edgeTenacity M u v = some (cut + 2) →
            (∃ k, s.minLabel u = some k) →
              (∃ k, s.minLabel v = some k) →
                match MaximumMatching.DDFS.Machine.executeFull ⋯ (F.root u) (F.root v) with
                | MaximumMatching.DDFS.Machine.FullOutput.disjoint p q red green separate =>
                  ∃ z,
                    z.Augmenting ∧
                      z.length = cut + 2 ∧
                        z.ContainsEdge u v ∧ ∀ (r : MaximumMatching.AltPath M), r.Augmenting → z.length ≤ r.length
                | MaximumMatching.DDFS.Machine.FullOutput.bottleneck b S trees highest region =>
                  ∀ (w : Fin n),
                    S w → w ≠ b → MaximumMatching.tenacity M w = some (cut + 2) ∧ MaximumMatching.InSupport M u v w
@MaximumMatching.Search.PetalRecord.maxEvent_correct_of_current : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} [inst : DecidableRel G.Adj] {cut : Nat} (R : MaximumMatching.Search.PetalRecord M)
  (P : MaximumMatching.Search.CurrentBridgeRepresentation M cut ⋯) (i cutoff : Nat),
  cut % 2 = 1 →
    MaximumMatching.AtMostShortestAugmenting M (cut + 2) →
      R.tenacity = cut + 2 →
        cut + 2 = 2 * i + 1 →
          R.cap = i + 1 →
            MaximumMatching.Search.StageState M (i + 1) cutoff R.prior →
              MaximumMatching.Search.StageState M (i + 1) cutoff (R.maxEvent i).fst ∧
                MaximumMatching.Search.BudGraphInvariant M (i + 1) (R.maxEvent i).fst (R.maxEvent i).snd ∧
                  (∀ (v : Fin n), v ∈ R.newRoots → (R.maxEvent i).fst.maxLabel v = MaximumMatching.maxlevel M v) ∧
                    ∀ (v : Fin n) (k : Nat), R.prior.maxLabel v = some k → (R.maxEvent i).fst.maxLabel v = some k
@MaximumMatching.Search.PetalRecord.maxEvent_representation : {n : Nat} →
  {G : MaximumMatching.Graph (Fin n)} →
    {M : MaximumMatching.Matching G} →
      [inst : DecidableRel G.Adj] →
        {cut : Nat} →
          (R : MaximumMatching.Search.PetalRecord M) →
            MaximumMatching.Search.CurrentBridgeRepresentation M cut ⋯ →
              (i : Nat) →
                {cap' : Nat} →
                  (h' : MaximumMatching.Search.BudGraphInvariant M cap' (R.maxEvent i).fst R.after) →
                    MaximumMatching.Search.CurrentBridgeRepresentation M cut h'
@MaximumMatching.Search.PetalRecord.transport_path : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} (R : MaximumMatching.Search.PetalRecord M)
  (p : MaximumMatching.DDFS.Path (MaximumMatching.Search.predecessorGraph R.prior R.forest ⋯)),
  (∀ (v : Fin n), p.Contains v → R.forest.root v = v) →
    ∃ q,
      q.first = R.after.root p.first ∧
        q.last = R.after.root p.last ∧
          q.length ≤ p.length ∧ ∀ (w : Fin n), q.Contains w ↔ ∃ v, p.Contains v ∧ R.after.root v = w
@MaximumMatching.Search.PetalRecord.transport_disjoint_paths : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} (R : MaximumMatching.Search.PetalRecord M)
  (p q : MaximumMatching.DDFS.Path (MaximumMatching.Search.predecessorGraph R.prior R.forest ⋯)),
  (∀ (v : Fin n), p.Contains v → R.forest.root v = v) →
    (∀ (v : Fin n), q.Contains v → R.forest.root v = v) →
      p.Disjoint q →
        ¬R.selected p.last →
          (MaximumMatching.Search.predecessorGraph R.prior R.forest ⋯).level q.last = 0 →
            ∃ a b,
              a.first = R.after.root p.first ∧
                a.last = p.last ∧
                  b.first = R.after.root q.first ∧
                    b.last = q.last ∧
                      a.Disjoint b ∧
                        (∀ (v : Fin n), a.Contains v ↔ ∃ u, p.Contains u ∧ R.after.root u = v) ∧
                          ∀ (v : Fin n), b.Contains v ↔ ∃ u, q.Contains u ∧ R.after.root u = v
@MaximumMatching.Search.runCurrentBucket : {n : Nat} →
  {G : MaximumMatching.Graph (Fin n)} →
    [DecidableRel G.Adj] →
      {M : MaximumMatching.Matching G} →
        {i cut : Nat} →
          cut % 2 = 1 →
            MaximumMatching.AtMostShortestAugmenting M (cut + 2) →
              cut + 2 = 2 * i + 1 →
                (B : MaximumMatching.Search.CurrentBucketState M i cut) →
                  (es : List (Fin n × Fin n)) →
                    (∀ (e : Fin n × Fin n), e ∈ es → e ∈ B.state.bucket (2 * i + 1)) →
                      MaximumMatching.Search.CurrentBucketOutcome M i cut × List (MaximumMatching.Search.PetalRecord M)
@MaximumMatching.Search.CurrentBucketWitness.shortest_augmenting : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} {i cut : Nat} {B : MaximumMatching.Search.CurrentBucketState M i cut}
  (W : MaximumMatching.Search.CurrentBucketWitness B),
  cut % 2 = 1 →
    MaximumMatching.AtMostShortestAugmenting M (cut + 2) →
      cut + 2 = 2 * i + 1 →
        ∃ p,
          p.Augmenting ∧
            p.length = 2 * i + 1 ∧
              p.ContainsEdge W.left W.right ∧ ∀ (q : MaximumMatching.AltPath M), q.Augmenting → p.length ≤ q.length
@MaximumMatching.Search.runCurrentBucket_root_congr : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} [inst : DecidableRel G.Adj] {i cut : Nat} (hc : cut % 2 = 1)
  (htop : MaximumMatching.AtMostShortestAugmenting M (cut + 2)) (hstageTen : cut + 2 = 2 * i + 1)
  (B : MaximumMatching.Search.CurrentBucketState M i cut) (es : List (Fin n × Fin n))
  (hqueued : ∀ (e : Fin n × Fin n), e ∈ es → e ∈ B.state.bucket (2 * i + 1)) (u v : Fin n),
  B.forest.root u = B.forest.root v →
    (MaximumMatching.Search.runCurrentBucket hc htop hstageTen B es hqueued).fst.state.forest.root u =
      (MaximumMatching.Search.runCurrentBucket hc htop hstageTen B es hqueued).fst.state.forest.root v
