@MaximumMatching.DDFS.lift_path : ∀ {V : Type} {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G}
  {H : MaximumMatching.DDFS.LayeredGraph V},
  MaximumMatching.DDFS.LayeredMatching M H →
    ∀ (q : MaximumMatching.DDFS.Path H) (p : MaximumMatching.AltPath M),
      p.last = q.last →
        (∀ (i : Fin (p.length + 1)), H.level (p.vertex i) = ↑i) →
          ∃ r,
            r.first = p.first ∧
              r.last = q.first ∧
                r.length = H.level q.first ∧
                  (∀ (i : Fin (r.length + 1)), H.level (r.vertex i) = ↑i) ∧
                    ∀ (v : V), (∃ i, r.vertex i = v) ↔ (∃ i, p.vertex i = v) ∨ q.Contains v
@MaximumMatching.DDFS.bridge_detour : ∀ {V : Type} {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G}
  {H : MaximumMatching.DDFS.LayeredGraph V},
  MaximumMatching.DDFS.LayeredMatching M H →
    ∀ (r g b w : V) (α : Nat),
      H.level r = α →
        H.level g = α →
          G.Adj g r →
            (M.mate g = some r ↔ α % 2 = 1) →
              ∀ (a q : MaximumMatching.DDFS.Path H),
                a.first = r →
                  a.last = w →
                    q.first = g →
                      q.last = b →
                        a.Disjoint q →
                          H.level b < H.level w →
                            ∀ (p : MaximumMatching.AltPath M),
                              p.last = b →
                                (∀ (i : Fin (p.length + 1)), H.level (p.vertex i) = ↑i) →
                                  ∃ z, z.first = p.first ∧ z.last = w ∧ z.length = 2 * α + 1 - H.level w
