@MaximumMatching.blossoms_laminar : ∀ {V : Type} {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G}
  (s t : Nat),
  s % 2 = 1 →
    t % 2 = 1 →
      ∀ (b c : V),
        MaximumMatching.levelLT (some s) (MaximumMatching.tenacity M b) →
          MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M c) →
            (∃ v, MaximumMatching.Blossom M s b v ∧ MaximumMatching.Blossom M t c v) →
              (∀ (v : V), MaximumMatching.Blossom M s b v → MaximumMatching.Blossom M t c v) ∨
                ∀ (v : V), MaximumMatching.Blossom M t c v → MaximumMatching.Blossom M s b v
@MaximumMatching.minimum_blossom_relative_paths : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (t : Nat),
  MaximumMatching.EligibleTenacity M t →
    (∀ (w : V), MaximumMatching.levelLE (some t) (MaximumMatching.tenacity M w)) →
      ∀ (b v : V),
        MaximumMatching.Blossom M t b v →
          ∀ (q : MaximumMatching.AltSegment M),
            q.Shortest →
              q.first = b →
                q.last = v →
                  (∀ (w : V), q.Contains w → w = b ∨ MaximumMatching.Blossom M t b w) ∧
                    ∀ (k : Fin q.length),
                      MaximumMatching.edgeTenacity M (q.vertex ⟨↑k, ⋯⟩) (q.vertex ⟨↑k + 1, ⋯⟩) = some t
