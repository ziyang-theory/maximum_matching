@MaximumMatching.Search.recordQueuedPetal_origin : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} {cap : Nat} {s : MaximumMatching.Search.State (Fin n)}
