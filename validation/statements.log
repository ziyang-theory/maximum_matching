@MaximumMatching.AltPath.low_vertex_boundary_before : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M) (t : Nat),
  t % 2 = 1 →
    (∀ (v : V) (s : Nat), MaximumMatching.tenacity M v = some s → s ≤ t → ∃ b, MaximumMatching.IsBase M v b) →
      (∀ (b v : V),
          MaximumMatching.Blossom M t b v →
            MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
              ∀ (q : MaximumMatching.AltSegment M),
                q.Shortest →
                  q.first = b → q.last = v → ∀ (w : V), q.Contains w → w = b ∨ MaximumMatching.Blossom M t b w) →
        ∀ (k B : Fin (p.length + 1)),
          ↑k < ↑B →
            MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M p.first) →
              MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M (p.vertex B)) →
                MaximumMatching.levelLE (MaximumMatching.tenacity M (p.vertex k)) (some t) →
                  (∀ (j : Fin (p.length + 1)),
                      ↑j ≤ ↑B →
                        MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M (p.vertex j)) →
                          MaximumMatching.minlevel M (p.vertex j) = some ↑j) →
                    ∃ i,
                      ↑i < ↑k ∧
                        MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M (p.vertex i)) ∧
                          MaximumMatching.Blossom M t (p.vertex i) (p.vertex k)
@MaximumMatching.AltPath.blossom_member_before_high_forces_boundary : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M) (t : Nat),
  t % 2 = 1 →
    (∀ (v : V) (s : Nat), MaximumMatching.tenacity M v = some s → s ≤ t → ∃ b, MaximumMatching.IsBase M v b) →
      (∀ (b v : V),
          MaximumMatching.Blossom M t b v →
            MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
              ∀ (q : MaximumMatching.AltSegment M),
                q.Shortest →
                  q.first = b → q.last = v → ∀ (w : V), q.Contains w → w = b ∨ MaximumMatching.Blossom M t b w) →
        ∀ (k B : Fin (p.length + 1)),
          ↑k < ↑B →
            MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M p.first) →
              MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M (p.vertex B)) →
                (∀ (j : Fin (p.length + 1)),
                    ↑j ≤ ↑B →
                      MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M (p.vertex j)) →
                        MaximumMatching.minlevel M (p.vertex j) = some ↑j) →
                  ∀ (c : V),
                    MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M c) →
                      MaximumMatching.Blossom M t c (p.vertex k) → ∃ i, ↑i < ↑k ∧ p.vertex i = c
@MaximumMatching.DDFS.BlossomWeightedMatching.bridge_detour_of_potential : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} {H : MaximumMatching.DDFS.LayeredGraph V} {t : Nat}
  (W : MaximumMatching.DDFS.BlossomWeightedMatching M H t) (p q : MaximumMatching.DDFS.Path H),
  (∀ (v : V), p.Contains v → MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M v)) →
    (∀ (v : V), q.Contains v → MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M v)) →
      p.Disjoint q →
        ∀ (a b : MaximumMatching.ParitySegment M),
          a.last = p.first →
            b.last = q.first →
              (a.phase + a.length) % 2 = W.phase p.first % 2 →
                (b.phase + b.length) % 2 = W.phase q.first % 2 →
                  (∀ (i : Fin (a.length + 1)), ↑i < a.length → MaximumMatching.Blossom M t p.first (a.vertex i)) →
                    (∀ (i : Fin (b.length + 1)), ↑i < b.length → MaximumMatching.Blossom M t q.first (b.vertex i)) →
                      M.Free q.last →
                        a.phase % 2 = b.phase % 2 →
                          G.Adj b.first a.first →
                            (M.mate b.first = some a.first ↔ (b.phase + 1) % 2 = 1) →
                              ∀ (height : V → Nat),
                                (∀ {u v : V} (he : H.Edge u v), (W.segment he).length + height v = height u) →
                                  height q.last = 0 →
                                    ∀ (budget : Nat),
                                      a.length + height p.first + (b.length + height q.first) + 1 = budget →
                                        ∃ z,
                                          z.first = q.last ∧
                                            z.last = p.last ∧
                                              z.length + height p.last = budget ∧ z.length = budget - height p.last
@MaximumMatching.ParitySegment.bridge_join : ∀ {V : Type} {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G}
  (a b : MaximumMatching.ParitySegment M),
  M.Free b.last →
    (∀ (i : Fin (b.length + 1)) (j : Fin (a.length + 1)), b.vertex i ≠ a.vertex j) →
      a.phase % 2 = b.phase % 2 →
        G.Adj b.first a.first →
          (M.mate b.first = some a.first ↔ (b.phase + 1) % 2 = 1) →
            ∃ z, z.first = b.last ∧ z.last = a.last ∧ z.length = b.length + 1 + a.length
