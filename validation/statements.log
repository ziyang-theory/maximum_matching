MaximumMatching.exists_differenceFamily : ∀ (n : Nat) (G : MaximumMatching.Graph (Fin n))
  (M N : MaximumMatching.Matching G), ∃ f, f.count = N.cardinality - M.cardinality
@MaximumMatching.deficit_of_long_paths : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  (M N : MaximumMatching.Matching G) (l : Nat),
  (∀ (p : MaximumMatching.AltPath M), p.Augmenting → l ≤ p.length) → (N.cardinality - M.cardinality) * (l + 1) ≤ n
@MaximumMatching.AugmentingFamily.shortest_length_increases : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} (f : MaximumMatching.AugmentingFamily M) (l : Nat),
  f.MaximalShortest l → ∀ (q : MaximumMatching.AltPath f.run), q.Augmenting → l < q.length
@MaximumMatching.PhaseDriver.run_isMaximum : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  (search : MaximumMatching.PhaseDriver.Search G),
  MaximumMatching.PhaseDriver.Complete search →
    ∀ (M : MaximumMatching.Matching G), (MaximumMatching.PhaseDriver.run search M).matching.IsMaximum
@MaximumMatching.PhaseDriver.run_positivePhases_le_two_sqrt : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  (search : MaximumMatching.PhaseDriver.Search G),
  MaximumMatching.PhaseDriver.ShortestBlocking search →
    ∀ (M : MaximumMatching.Matching G), (MaximumMatching.PhaseDriver.run search M).positivePhases ≤ 2 * n.sqrt
@MaximumMatching.BudForest.compressMany_root : ∀ {V : Type} [inst : DecidableEq V] (F : MaximumMatching.BudForest V)
  (xs : List V) (v : V), (F.compressMany xs).root v = F.root v
@MaximumMatching.Search.scan_tie_adds_predecessor : ∀ {V : Type} [inst : DecidableEq V] {G : MaximumMatching.Graph V}
  (M : MaximumMatching.Matching G) (i : Nat) (u v : V) (s : MaximumMatching.Search.State V),
  MaximumMatching.Search.seen s u v = false →
    s.minLabel v = some (i + 1) → (MaximumMatching.Search.scan M i u v s).predecessors v = u :: s.predecessors v
@MaximumMatching.Search.scan_reverse_noop : ∀ {V : Type} [inst : DecidableEq V] {G : MaximumMatching.Graph V}
  (M : MaximumMatching.Matching G) (i j : Nat) (u v : V) (s : MaximumMatching.Search.State V),
  MaximumMatching.Search.scan M j v u (MaximumMatching.Search.scan M i u v s) = MaximumMatching.Search.scan M i u v s
@MaximumMatching.AltPath.minlevel_last_predecessor_honest : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M),
  MaximumMatching.minlevel M p.last = some p.length → ∀ (hpos : 0 < p.length), p.BFSHonest ⟨p.length - 1, ⋯⟩
@MaximumMatching.predecessor_iff_level_guard : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (u v : V) (i : Nat),
  MaximumMatching.minlevel M v = some (i + 1) →
    (MaximumMatching.Predecessor M u v ↔
      G.Adj u v ∧ MaximumMatching.level M (i % 2) u = some i ∧ (M.mate u = some v ↔ i % 2 = 1))
@MaximumMatching.Search.scan_assigns_semantic : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} [inst : DecidableEq V] (s : MaximumMatching.Search.State V) (i : Nat) (u v : V),
  MaximumMatching.Search.MinCompleteBelow M i s →
    MaximumMatching.level M (i % 2) u = some i →
      G.Adj u v →
        (M.mate u = some v ↔ i % 2 = 1) →
          MaximumMatching.Search.seen s u v = false →
            MaximumMatching.Search.admits (s.minLabel v) (i + 1) = true →
              MaximumMatching.minlevel M v = some (i + 1) ∧
                MaximumMatching.Predecessor M u v ∧
                  (MaximumMatching.Search.scan M i u v s).minLabel v = some (i + 1) ∧
                    (MaximumMatching.Search.scan M i u v s).predecessors v = u :: s.predecessors v
@MaximumMatching.Search.scan_rejects_bridge : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} [inst : DecidableEq V] (s : MaximumMatching.Search.State V) (i : Nat) (u v : V),
  MaximumMatching.Search.LabelsSound M s →
    MaximumMatching.Search.EarlierPropsSeen M i s →
      MaximumMatching.level M (i % 2) u = some i →
        G.Adj u v →
          MaximumMatching.Search.seen s u v = false →
            MaximumMatching.Search.admits (s.minLabel v) (i + 1) = false → MaximumMatching.Bridge M u v
@MaximumMatching.Search.scanCandidates_preserves : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} [inst : DecidableEq V] [inst_1 : DecidableRel G.Adj] (candidates : List (V × V))
  (s : MaximumMatching.Search.State V) (i : Nat),
  MaximumMatching.Search.LabelsSound M s →
    MaximumMatching.Search.MinCompleteBelow M i s →
      MaximumMatching.Search.LabelsSound M (MaximumMatching.Search.scanCandidates M i candidates s) ∧
        MaximumMatching.Search.MinCompleteBelow M i (MaximumMatching.Search.scanCandidates M i candidates s)
@MaximumMatching.Search.initial_scanCandidates_labelsSound : ∀ {V : Type} {G : MaximumMatching.Graph V}
  [inst : DecidableEq V] [inst_1 : DecidableRel G.Adj] (M : MaximumMatching.Matching G) (candidates : List (V × V)),
  MaximumMatching.Search.LabelsSound M
    (MaximumMatching.Search.scanCandidates M 0 candidates (MaximumMatching.Search.initial M))
