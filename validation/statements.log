@MaximumMatching.Search.PetalRecord.maxEvent_correct : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} [inst : DecidableRel G.Adj] (R : MaximumMatching.Search.PetalRecord M)
  (i cut cutoff : Nat),
  cut % 2 = 1 →
    MaximumMatching.AtMostShortestAugmenting M (cut + 2) →
      MaximumMatching.Search.LowerBlossomRepresentation M cut R.prior R.forest →
