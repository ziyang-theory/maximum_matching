@MaximumMatching.AltPath.base_eq_of_shortest_prefix : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M),
  p.Shortest →
    ∀ (t : Nat),
      MaximumMatching.EligibleTenacity M t →
        MaximumMatching.tenacity M p.last = some t →
          ∀ (i : Fin (p.length + 1)),
            MaximumMatching.tenacity M (p.vertex i) = some t →
              (p.take ↑i ⋯).Shortest →
                (∀ (j : Fin (p.length + 1)),
                    ↑i < ↑j → MaximumMatching.levelLE (MaximumMatching.tenacity M (p.vertex j)) (some t)) →
                  MaximumMatching.base M p.last = MaximumMatching.base M (p.vertex i)
@MaximumMatching.AltPath.reverse_stretch_minlevel_witness : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M) (t : Nat),
  t % 2 = 1 →
    ∀ (A J : Fin (p.length + 1)),
      ↑A < ↑J →
        ↑A % 2 = 0 →
          ↑J % 2 = 1 →
            ↑J ≤ t →
              t < 2 * ↑A →
                MaximumMatching.minlevel M (p.vertex A) = some (t - ↑A) →
                  MaximumMatching.minlevel M (p.vertex J) = some (t - ↑J) →
                    MaximumMatching.tenacity M (p.vertex J) = some t →
                      ∃ z,
                        z.length = t - ↑A ∧
                          z.last = p.vertex A ∧
                            MaximumMatching.minlevel M z.last = some z.length ∧
                              ∀ (K : Fin (p.length + 1)), ↑A ≤ ↑K → ↑K ≤ ↑J → ∃ L, ↑L = t - ↑K ∧ z.vertex L = p.vertex K
@MaximumMatching.DDFS.FiberWeightedMatching.realize : ∀ {V : Type} [inst : DecidableEq V] {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} {H : MaximumMatching.DDFS.LayeredGraph V} {F : MaximumMatching.BudForest V}
  (W : MaximumMatching.DDFS.FiberWeightedMatching M H F) (p : MaximumMatching.DDFS.Path H),
  (∀ (v : V), p.Contains v → F.root v = v) →
    ∃ s,
      s.first = p.first ∧
        s.last = p.last ∧
          s.length = W.weight p ∧
            s.phase % 2 = W.phase p.first % 2 ∧
              (s.phase + s.length) % 2 = W.phase p.last % 2 ∧
                (∀ (v : V), s.Contains v → p.Contains (F.root v)) ∧
                  ∀ (v : V), s.Contains v → F.root v = p.first → v = p.first
@MaximumMatching.DDFS.FiberWeightedMatching.bridge_detour_of_potential_contains : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {H : MaximumMatching.DDFS.LayeredGraph V}
  {F : MaximumMatching.BudForest V} (W : MaximumMatching.DDFS.FiberWeightedMatching M H F)
  (p q : MaximumMatching.DDFS.Path H),
  (∀ (v : V), p.Contains v → F.root v = v) →
    (∀ (v : V), q.Contains v → F.root v = v) →
      p.Disjoint q →
        ∀ (a b : MaximumMatching.ParitySegment M),
          a.last = p.first →
            b.last = q.first →
              (a.phase + a.length) % 2 = W.phase p.first % 2 →
                (b.phase + b.length) % 2 = W.phase q.first % 2 →
                  (∀ (i : Fin (a.length + 1)), ↑i < a.length → F.root (a.vertex i) = p.first) →
                    (∀ (i : Fin (b.length + 1)), ↑i < b.length → F.root (b.vertex i) = q.first) →
                      M.Free q.last →
                        a.phase % 2 = b.phase % 2 →
                          G.Adj b.first a.first →
                            (M.mate b.first = some a.first ↔ (b.phase + 1) % 2 = 1) →
                              ∀ (height : V → Nat),
                                (∀ {u v : V} (he : H.Edge u v), (W.segment he).length + height v = height u) →
                                  height q.last = 0 →
                                    ∀ (budget : Nat),
                                      a.length + height p.first + (b.length + height q.first) + 1 = budget →
                                        ∃ z,
                                          z.first = q.last ∧
                                            z.last = p.last ∧
                                              z.length + height p.last = budget ∧
                                                z.length = budget - height p.last ∧ z.ContainsEdge b.first a.first
@MaximumMatching.Search.BudGraphInvariant.lower_blossom_fiber : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V},
  MaximumMatching.Search.BudGraphInvariant M cap s F →
    cut ≤ 2 * cap + 1 →
      MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
        ∀ (b v : V),
          MaximumMatching.levelLT (some cut) (MaximumMatching.tenacity M b) →
            MaximumMatching.Blossom M cut b v → F.root v = b
@MaximumMatching.Search.BudGraphInvariant.fiberWeightedMatching_drop : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M cap s F) (hc : cut % 2 = 1)
  (hnoaug : ∀ (p : MaximumMatching.AltPath M), p.Augmenting → cut < p.length) (hhalf : 2 * cap ≤ cut + 3)
  (hcap : cut ≤ 2 * cap + 1) (hrep : MaximumMatching.Search.LowerBlossomRepresentation M cut s F) {u v : V}
  (he : (MaximumMatching.Search.predecessorGraph s F h).Edge u v),
  ((h.fiberWeightedMatching hc hnoaug hhalf hcap hrep).segment he).length + (s.minLabel v).getD 0 =
    (s.minLabel u).getD 0
@MaximumMatching.AltPath.current_bridge_prefix_honest : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M) (t : Nat),
  MaximumMatching.AtMostShortestAugmenting M t →
