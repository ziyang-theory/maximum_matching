              ∀ (q : MaximumMatching.AltSegment M),
                q.Shortest →
                  q.first = p.last →
                    q.last = v → ∀ (w : V), q.Contains w → w = p.last ∨ MaximumMatching.Blossom M t p.last w) →
          (∃ i, MaximumMatching.Blossom M t p.last (p.vertex i)) →
            ∃ D,
              ↑D % 2 = 1 ∧
                MaximumMatching.Blossom M t p.last (p.vertex D) ∧
                  (∀ (a : Fin (p.length + 1)), ↑a < ↑D → ¬MaximumMatching.Blossom M t p.last (p.vertex a)) ∧
                    (p.reverseOddTail hpo D).Shortest ∧
                      ∀ (j : Fin (p.length + 1)),
                        ↑D ≤ ↑j → p.vertex j = p.last ∨ MaximumMatching.Blossom M t p.last (p.vertex j)
@MaximumMatching.AltPath.dishonest_last_predecessor_outer : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M),
  p.Shortest →
    ∀ (t : Nat),
      MaximumMatching.tenacity M p.last = some t →
        ∀ (hpos : 0 < p.length), ¬p.BFSHonest ⟨p.length - 1, ⋯⟩ → p.length % 2 = 1 ∧ MaximumMatching.Outer M p.last
@MaximumMatching.AltPath.dishonest_outer_predecessor_base : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M),
  p.Shortest →
    ∀ (hpo : p.length % 2 = 1),
      MaximumMatching.Outer M p.last →
        ∀ (t s : Nat),
          MaximumMatching.tenacity M p.last = some t →
            MaximumMatching.tenacity M (p.vertex ⟨p.length - 1, ⋯⟩) = some s →
              s < t →
                (∃ b, MaximumMatching.IsBase M (p.vertex ⟨p.length - 1, ⋯⟩) b) →
                  ¬p.BFSHonest ⟨p.length - 1, ⋯⟩ →
                    MaximumMatching.IsBase M (p.vertex ⟨p.length - 1, ⋯⟩) p.last ∧
                      MaximumMatching.Blossom M (t - 2) p.last (p.vertex ⟨p.length - 1, ⋯⟩)
@MaximumMatching.blossom_append_relative_shortest : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (t : Nat) (b v : V) (hv : MaximumMatching.Blossom M t b v)
  (hb : MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b)) (p : MaximumMatching.AltPath M)
  (hp : p.Shortest) (hpe : p.length % 2 = 0) (hpb : p.last = b) (q : MaximumMatching.AltSegment M) (hq : q.Shortest)
  (hqb : q.first = b) (hqv : q.last = v), (p.appendSegment q hpe ⋯ ⋯).Shortest
@MaximumMatching.lower_endpoint_blossom_relative_confined : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (t : Nat),
  t % 2 = 1 →
    (∀ (v : V) (s : Nat), MaximumMatching.tenacity M v = some s → s ≤ t - 2 → ∃ b, MaximumMatching.IsBase M v b) →
      (∀ (b v : V),
          MaximumMatching.Blossom M (t - 2) b v →
            MaximumMatching.levelLT (some (t - 2)) (MaximumMatching.tenacity M b) →
              ∀ (q : MaximumMatching.AltSegment M),
                q.Shortest →
                  q.first = b → q.last = v → ∀ (w : V), q.Contains w → w = b ∨ MaximumMatching.Blossom M (t - 2) b w) →
        (∀ (v : V), MaximumMatching.tenacity M v = some t → ∃ b, MaximumMatching.IsBase M v b) →
          ∀ (b v : V),
            MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
              MaximumMatching.Blossom M t b v →
                ∀ (s : Nat),
                  MaximumMatching.tenacity M v = some s →
                    s < t →
                      ∀ (q : MaximumMatching.AltSegment M),
                        q.Shortest →
                          q.first = b → q.last = v → ∀ (w : V), q.Contains w → w = b ∨ MaximumMatching.Blossom M t b w
@MaximumMatching.blossom_low_crossing_bridge : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (t : Nat),
  t % 2 = 1 →
    (∀ (v : V) (s : Nat), MaximumMatching.tenacity M v = some s → s ≤ t → ∃ b, MaximumMatching.IsBase M v b) →
      (∀ (c w : V),
          MaximumMatching.Blossom M t c w →
            MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M c) →
              ∀ (q : MaximumMatching.AltSegment M),
                q.Shortest →
                  q.first = c → q.last = w → ∀ (z : V), q.Contains z → z = c ∨ MaximumMatching.Blossom M t c z) →
        ∀ (b u v : V),
          MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
            MaximumMatching.Blossom M t b v →
              MaximumMatching.levelLE (MaximumMatching.tenacity M u) (some t) →
                ¬MaximumMatching.Blossom M t b u → G.Adj u v → MaximumMatching.Bridge M u v
@MaximumMatching.AltPath.late_low_stretch_mem : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M) (t : Nat),
  t % 2 = 1 →
    (∀ (v : V) (s : Nat), MaximumMatching.tenacity M v = some s → s ≤ t - 2 → ∃ b, MaximumMatching.IsBase M v b) →
      (∀ (b v : V),
          MaximumMatching.Blossom M (t - 2) b v →
            MaximumMatching.levelLT (some (t - 2)) (MaximumMatching.tenacity M b) →
              ∀ (q : MaximumMatching.AltSegment M),
                q.Shortest →
                  q.first = b → q.last = v → ∀ (w : V), q.Contains w → w = b ∨ MaximumMatching.Blossom M (t - 2) b w) →
        ∀ (A K J : Fin (p.length + 1)),
          ↑A < ↑K →
            ↑K < ↑J →
              ↑A % 2 = 0 →
                ↑J % 2 = 1 →
                  ↑J ≤ t →
                    t < 2 * ↑A →
                      MaximumMatching.minlevel M (p.vertex A) = some (t - ↑A) →
                        MaximumMatching.minlevel M (p.vertex J) = some (t - ↑J) →
                          MaximumMatching.tenacity M (p.vertex J) = some t →
                            (∀ (k : Fin (p.length + 1)),
                                ↑A < ↑k →
                                  ↑k < ↑J →
                                    MaximumMatching.levelLE (MaximumMatching.tenacity M (p.vertex k)) (some (t - 2))) →
                              MaximumMatching.Blossom M (t - 2) (p.vertex J) (p.vertex K)
@MaximumMatching.general_suffix_base : ∀ {V : Type} {G : MaximumMatching.Graph V} (M : MaximumMatching.Matching G)
  (t : Nat),
  MaximumMatching.EligibleTenacity M t →
    ∀ (p : MaximumMatching.AltPath M),
      p.Shortest →
        MaximumMatching.tenacity M p.last = some t →
          ∀ (b : V),
            MaximumMatching.IsBase M p.last b →
              ∀ (i j : Fin (p.length + 1)),
                p.vertex i = b → ↑i < ↑j → ∃ k, ↑i ≤ ↑k ∧ MaximumMatching.base M (p.vertex j) = some (p.vertex k)
@MaximumMatching.general_blossom_relative_base : ∀ {V : Type} {G : MaximumMatching.Graph V}
  (M : MaximumMatching.Matching G) (t : Nat),
  MaximumMatching.EligibleTenacity M t →
    ∀ (b v : V),
      MaximumMatching.Blossom M t b v →
        MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
          ∀ (q : MaximumMatching.AltSegment M),
            q.Shortest →
              q.first = b →
                q.last = v →
                  ∀ (j : Fin (q.length + 1)), 0 < ↑j → ∃ a, MaximumMatching.IsBase M (q.vertex j) a ∧ q.Contains a
@MaximumMatching.general_blossom_edge_bounds : ∀ {V : Type} {G : MaximumMatching.Graph V}
  (M : MaximumMatching.Matching G) (t : Nat),
  MaximumMatching.EligibleTenacity M t →
    (∀ (p : MaximumMatching.AltPath M),
        p.Shortest →
          ∀ (b : V),
            MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
              MaximumMatching.Blossom M t b p.last →
                ∀ (i : Fin (p.length + 1)),
                  p.vertex i = b →
                    ∀ (k : Fin p.length),
                      ↑i ≤ ↑k →
                        MaximumMatching.levelLE
                          (MaximumMatching.edgeTenacity M (p.vertex ⟨↑k, ⋯⟩) (p.vertex ⟨↑k + 1, ⋯⟩)) (some t)) ∧
      ∀ (b v : V),
        MaximumMatching.Blossom M t b v →
          MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
            ∀ (q : MaximumMatching.AltSegment M),
              q.Shortest →
                q.first = b →
                  q.last = v →
                    ∀ (k : Fin q.length),
                      MaximumMatching.levelLE (MaximumMatching.edgeTenacity M (q.vertex ⟨↑k, ⋯⟩) (q.vertex ⟨↑k + 1, ⋯⟩))
                        (some t)
@MaximumMatching.general_blossom_relative_edge_bound : ∀ {V : Type} {G : MaximumMatching.Graph V}
  (M : MaximumMatching.Matching G) (t : Nat),
  MaximumMatching.EligibleTenacity M t →
    ∀ (b v : V),
      MaximumMatching.Blossom M t b v →
        MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M b) →
          ∀ (q : MaximumMatching.AltSegment M),
            q.Shortest →
              q.first = b →
                q.last = v →
                  ∀ (k : Fin q.length),
                    MaximumMatching.levelLE (MaximumMatching.edgeTenacity M (q.vertex ⟨↑k, ⋯⟩) (q.vertex ⟨↑k + 1, ⋯⟩))
                      (some t)
@MaximumMatching.AltPath.general_maxlevel_path_unique_bridge : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (p : MaximumMatching.AltPath M) (t : Nat),
  MaximumMatching.AtMostShortestAugmenting M t →
    MaximumMatching.tenacity M p.last = some t →
      MaximumMatching.maxlevel M p.last = some p.length → p.UniqueBridgeOfTenacity t
@MaximumMatching.AltPath.unique_bridge_maxlevel_of_lower : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (t : Nat),
  t % 2 = 1 →
    (∀ (v : V) (s : Nat), MaximumMatching.tenacity M v = some s → s ≤ t - 2 → ∃ b, MaximumMatching.IsBase M v b) →
      (∀ (b v : V),
          MaximumMatching.Blossom M (t - 2) b v →
            MaximumMatching.levelLT (some (t - 2)) (MaximumMatching.tenacity M b) →
              ∀ (q : MaximumMatching.AltSegment M),
                q.Shortest →
                  q.first = b → q.last = v → ∀ (w : V), q.Contains w → w = b ∨ MaximumMatching.Blossom M (t - 2) b w) →
        (∀ (b v : V),
            MaximumMatching.Blossom M (t - 2) b v →
              MaximumMatching.levelLT (some (t - 2)) (MaximumMatching.tenacity M b) →
                ∀ (q : MaximumMatching.AltSegment M),
                  q.Shortest →
                    q.first = b →
                      q.last = v →
                        ∀ (i : Fin q.length),
                          MaximumMatching.levelLE
                            (MaximumMatching.edgeTenacity M (q.vertex ⟨↑i, ⋯⟩) (q.vertex ⟨↑i + 1, ⋯⟩)) (some (t - 2))) →
          ∀ (p : MaximumMatching.AltPath M),
            MaximumMatching.tenacity M p.last = some t →
              MaximumMatching.maxlevel M p.last = some p.length → p.UniqueBridgeOfTenacity t
@MaximumMatching.vertex_in_bridge_support : ∀ {V : Type} {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G}
  (v : V) (t : Nat),
  MaximumMatching.AtMostShortestAugmenting M t →
    MaximumMatching.tenacity M v = some t →
      ∃ u w, MaximumMatching.edgeTenacity M u w = some t ∧ MaximumMatching.InSupport M u w v
@MaximumMatching.tenacity_iff_bridge_support : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (v : V) (t : Nat),
  MaximumMatching.AtMostShortestAugmenting M t →
    (MaximumMatching.tenacity M v = some t ↔
      ∃ u w, MaximumMatching.edgeTenacity M u w = some t ∧ MaximumMatching.InSupport M u w v)
@MaximumMatching.BudForest.mergeInto_root : ∀ {V : Type} [inst : DecidableEq V] (F : MaximumMatching.BudForest V)
  (x b v : V),
  (F.mergeInto x b).root v = if F.rank (F.root b) < F.rank (F.root x) ∧ F.root v = F.root x then F.root b else F.root v
@MaximumMatching.BudForest.mergeManyInto_source : ∀ {V : Type} [inst : DecidableEq V] (F : MaximumMatching.BudForest V)
  (xs : List V) (x b : V),
  x ∈ xs → F.rank (F.root b) < F.rank (F.root x) ∨ F.root x = F.root b → (F.mergeManyInto xs b).root x = F.root b
@MaximumMatching.DDFS.ColoredTrees.mem_vertices : ∀ {n : Nat} {H : MaximumMatching.DDFS.LayeredGraph (Fin n)}
  {S : Fin n → Prop} {r g b : Fin n} (T : MaximumMatching.DDFS.ColoredTrees H S r g b) (v : Fin n), v ∈ T.vertices ↔ S v
@MaximumMatching.DDFS.Machine.executeAndContract : {n : Nat} →
  {H : MaximumMatching.DDFS.LayeredGraph (Fin n)} →
    [DecidableRel H.Edge] →
      MaximumMatching.DDFS.ReachBottom H →
        (r g : Fin n) →
          MaximumMatching.BudForest (Fin n) →
            MaximumMatching.DDFS.Machine.FullOutput H r g × MaximumMatching.BudForest (Fin n)
@MaximumMatching.DDFS.Machine.executeAndContract_bottleneck : ∀ {n : Nat}
  {H : MaximumMatching.DDFS.LayeredGraph (Fin n)} [inst : DecidableRel H.Edge]
  (hreach : MaximumMatching.DDFS.ReachBottom H) (r g : Fin n) (F : MaximumMatching.BudForest (Fin n)) (b : Fin n)
  (S : Fin n → Prop) (trees : MaximumMatching.DDFS.ColoredTrees H S r g b)
  (highest : MaximumMatching.DDFS.HighestBottleneck H r g b)
  (region : ∀ (v : Fin n), S v ↔ MaximumMatching.DDFS.OnRootTo r g b v),
  MaximumMatching.DDFS.Machine.executeFull hreach r g =
      MaximumMatching.DDFS.Machine.FullOutput.bottleneck b S trees highest region →
    (∀ (v : Fin n), F.rank v = H.level v) →
      (∀ (v : Fin n), S v → F.parent v = v) →
        ∀ (v : Fin n), S (F.root v) → (MaximumMatching.DDFS.Machine.executeAndContract hreach r g F).snd.root v = b
@MaximumMatching.DDFS.Machine.FullOutput.contract_root_congr : ∀ {n : Nat}
  {H : MaximumMatching.DDFS.LayeredGraph (Fin n)} {r g : Fin n} (out : MaximumMatching.DDFS.Machine.FullOutput H r g)
  (F : MaximumMatching.BudForest (Fin n)) (u v : Fin n),
  F.root u = F.root v → (out.contract F).root u = (out.contract F).root v
@MaximumMatching.BudForest.withLabels_root : ∀ {V : Type} [inst : DecidableEq V] (F : MaximumMatching.BudForest V)
  (labels next : V → Option Nat) (hrank : ∀ (v : V), F.rank v = (labels v).getD 0)
  (hroots : ∀ (v : V), (labels v).isSome = true → (labels (F.root v)).isSome = true)
  (hkeep : ∀ (v : V) (k : Nat), labels v = some k → next v = some k) (v : V),
  (F.withLabels labels next hrank hroots hkeep).root v = F.root v
@MaximumMatching.BudForest.withLabels_assignedRoots : ∀ {V : Type} [inst : DecidableEq V]
  (F : MaximumMatching.BudForest V) (labels next : V → Option Nat) (hrank : ∀ (v : V), F.rank v = (labels v).getD 0)
  (hroots : ∀ (v : V), (labels v).isSome = true → (labels (F.root v)).isSome = true)
  (hkeep : ∀ (v : V) (k : Nat), labels v = some k → next v = some k) (v : V),
  (next v).isSome = true → (next ((F.withLabels labels next hrank hroots hkeep).root v)).isSome = true
@MaximumMatching.BudForest.mergeManyInto_root_exact : ∀ {V : Type} [inst : DecidableEq V]
  (F : MaximumMatching.BudForest V) (xs : List V) (b v : V),
  (∀ (x : V), x ∈ xs → F.rank (F.root b) < F.rank (F.root x) ∨ F.root x = F.root b) →
    (F.mergeManyInto xs b).root v = if F.root v ∈ List.map F.root xs then F.root b else F.root v
@MaximumMatching.Search.initial_budGraphInvariant : ∀ {V : Type} [inst : DecidableEq V] {G : MaximumMatching.Graph V}
  (M : MaximumMatching.Matching G),
  MaximumMatching.Search.BudGraphInvariant M 0 (MaximumMatching.Search.initial M)
    (MaximumMatching.Search.uncontractedForest (MaximumMatching.Search.initial M))
@MaximumMatching.Search.BudGraphInvariant.edge_witness : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {i : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V},
  MaximumMatching.Search.BudGraphInvariant M i s F →
    ∀ {v w : V},
      MaximumMatching.Search.budEdge s F v w →
        ∃ u k j,
          s.minLabel v = some k ∧ s.minLabel u = some j ∧ MaximumMatching.Predecessor M u v ∧ F.root u = w ∧ j < k
@MaximumMatching.Search.BudGraphInvariant.reachBottom : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {i : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M i s F),
  MaximumMatching.DDFS.ReachBottom (MaximumMatching.Search.predecessorGraph s F h)
@MaximumMatching.Search.BudGraphInvariant.root_reaches_free : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {i : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M i s F) (v : V) (k : Nat),
  s.minLabel v = some k →
    ∃ p, p.first = F.root v ∧ M.Free p.last ∧ ∀ (j : Fin (p.length + 1)), F.parent (p.vertex j) = p.vertex j
@MaximumMatching.Search.scanLevelWithBuds_invariant : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  [inst : DecidableRel G.Adj] (M : MaximumMatching.Matching G) (i : Nat) (s : MaximumMatching.Search.State (Fin n))
  (F : MaximumMatching.BudForest (Fin n)) (h : MaximumMatching.Search.BudGraphInvariant M i s F),
  MaximumMatching.Search.MaxCompleteBelowTenacity M (2 * i + 1) s →
    MaximumMatching.Search.BudGraphInvariant M (i + 1) (MaximumMatching.Search.scanLevelWithBuds M i s F h).fst
      (MaximumMatching.Search.scanLevelWithBuds M i s F h).snd
@MaximumMatching.Search.executeBudSearch_vertices : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} {i : Nat} {s : MaximumMatching.Search.State (Fin n)}
  {F : MaximumMatching.BudForest (Fin n)} (h : MaximumMatching.Search.BudGraphInvariant M i s F) (r g : Fin n),
  (∃ k, s.minLabel r = some k) →
    (∃ k, s.minLabel g = some k) →
      match (MaximumMatching.Search.executeBudSearch h r g).fst with
      | MaximumMatching.DDFS.Machine.FullOutput.disjoint p q red green separate =>
        M.Free p.last ∧
          M.Free q.last ∧
            (∀ (j : Fin (p.length + 1)), (∃ k, s.minLabel (p.vertex j) = some k) ∧ F.parent (p.vertex j) = p.vertex j) ∧
              ∀ (j : Fin (q.length + 1)), (∃ k, s.minLabel (q.vertex j) = some k) ∧ F.parent (q.vertex j) = q.vertex j
      | MaximumMatching.DDFS.Machine.FullOutput.bottleneck b S trees highest region =>
        (∃ k, s.minLabel b = some k) ∧ ∀ (v : Fin n), S v → (∃ k, s.minLabel v = some k) ∧ F.parent v = v
@MaximumMatching.Search.executeBudSearch_preserves : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} {i : Nat} {s : MaximumMatching.Search.State (Fin n)}
  {F : MaximumMatching.BudForest (Fin n)} (h : MaximumMatching.Search.BudGraphInvariant M i s F) (r g : Fin n),
  (∃ k, s.minLabel r = some k) →
    (∃ k, s.minLabel g = some k) →
      MaximumMatching.Search.BudGraphInvariant M i s (MaximumMatching.Search.executeBudSearch h r g).snd
@MaximumMatching.Search.executeBudSearch_contracts : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} {i : Nat} {s : MaximumMatching.Search.State (Fin n)}
  {F : MaximumMatching.BudForest (Fin n)} (h : MaximumMatching.Search.BudGraphInvariant M i s F) (r g b : Fin n)
  (S : Fin n → Prop)
  (trees : MaximumMatching.DDFS.ColoredTrees (MaximumMatching.Search.predecessorGraph s F h) S (F.root r) (F.root g) b)
  (highest :
    MaximumMatching.DDFS.HighestBottleneck (MaximumMatching.Search.predecessorGraph s F h) (F.root r) (F.root g) b)
  (region : ∀ (v : Fin n), S v ↔ MaximumMatching.DDFS.OnRootTo (F.root r) (F.root g) b v),
  MaximumMatching.DDFS.Machine.executeFull ⋯ (F.root r) (F.root g) =
      MaximumMatching.DDFS.Machine.FullOutput.bottleneck b S trees highest region →
    ∀ (v : Fin n), S (F.root v) → (MaximumMatching.Search.executeBudSearch h r g).snd.root v = b
@MaximumMatching.predecessor_blossom_expansion : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (cut : Nat),
  MaximumMatching.EligibleTenacity M cut →
    ∀ (u v b : V),
      MaximumMatching.Predecessor M u v →
        MaximumMatching.Blossom M cut b u →
          MaximumMatching.levelLT (some cut) (MaximumMatching.tenacity M b) →
            ∀ (N B : Nat),
              MaximumMatching.minlevel M v = some N →
                MaximumMatching.minlevel M b = some B →
                  ∃ a,
                    a.first = v ∧
                      a.last = b ∧
                        a.length + B = N ∧
                          a.phase % 2 = (N + 1) % 2 ∧
                            (a.phase + a.length) % 2 = (B + 1) % 2 ∧
                              ∀ (k : Fin (a.length + 1)),
                                0 < ↑k → ↑k < a.length → MaximumMatching.Blossom M cut b (a.vertex k)
@MaximumMatching.Search.BudGraphInvariant.realize_bottom_path : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
  cut % 2 = 1 →
    (∀ (p : MaximumMatching.AltPath M), p.Augmenting → cut < p.length) →
      2 * cap ≤ cut + 3 →
        MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
          ∀ (p : MaximumMatching.DDFS.Path (MaximumMatching.Search.predecessorGraph s F h)),
            F.parent p.first = p.first →
              (∃ k, s.minLabel p.first = some k) →
                (MaximumMatching.Search.predecessorGraph s F h).level p.last = 0 →
                  ∃ q,
                    q.first = p.last ∧
                      q.last = p.first ∧
                        q.length = (s.minLabel p.first).getD 0 ∧
                          MaximumMatching.minlevel M q.last = some q.length ∧
                            ∀ (v : V), (∃ j, q.vertex j = v) → MaximumMatching.BlossomHull M cut p.Contains v
@MaximumMatching.Search.BudGraphInvariant.bridge_top_segments : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V},
  MaximumMatching.Search.BudGraphInvariant M cap s F →
    cut % 2 = 1 →
      (∀ (p : MaximumMatching.AltPath M), p.Augmenting → cut < p.length) →
        MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
          ∀ (u v : V),
            MaximumMatching.Bridge M u v →
              MaximumMatching.edgeTenacity M u v = some (cut + 2) →
                (∃ k, s.minLabel u = some k) →
                  (∃ k, s.minLabel v = some k) →
                    ∃ a b,
                      a.first = u ∧
                        a.last = F.root u ∧
                          b.first = v ∧
                            b.last = F.root v ∧
                              (a.phase + a.length) % 2 = ((s.minLabel (F.root u)).getD 0 + 1) % 2 ∧
                                (b.phase + b.length) % 2 = ((s.minLabel (F.root v)).getD 0 + 1) % 2 ∧
                                  (∀ (k : Fin (a.length + 1)),
                                      ↑k < a.length → MaximumMatching.Blossom M cut (F.root u) (a.vertex k)) ∧
                                    (∀ (k : Fin (b.length + 1)),
                                        ↑k < b.length → MaximumMatching.Blossom M cut (F.root v) (b.vertex k)) ∧
                                      a.phase % 2 = b.phase % 2 ∧
                                        (M.mate b.first = some a.first ↔ (b.phase + 1) % 2 = 1) ∧
                                          a.length + (s.minLabel (F.root u)).getD 0 +
                                                (b.length + (s.minLabel (F.root v)).getD 0) +
                                              1 =
                                            cut + 2
@MaximumMatching.Search.BudGraphInvariant.bridge_linkage_path : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
  cut % 2 = 1 →
    (∀ (p : MaximumMatching.AltPath M), p.Augmenting → cut < p.length) →
      2 * cap ≤ cut + 3 →
        MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
          ∀ (u v : V),
            MaximumMatching.Bridge M u v →
              MaximumMatching.edgeTenacity M u v = some (cut + 2) →
                (∃ k, s.minLabel u = some k) →
                  (∃ k, s.minLabel v = some k) →
                    ∀ (p q : MaximumMatching.DDFS.Path (MaximumMatching.Search.predecessorGraph s F h)),
                      p.first = F.root u →
                        q.first = F.root v →
                          (MaximumMatching.Search.predecessorGraph s F h).level q.last = 0 →
                            p.Disjoint q →
                              ∃ z,
                                z.first = q.last ∧
                                  z.last = p.last ∧ z.length + (s.minLabel p.last).getD 0 = cut + 2 ∧ z.ContainsEdge u v
@MaximumMatching.Search.BudGraphInvariant.disjoint_bridge_paths_shortest : ∀ {V : Type} [inst : DecidableEq V]
  {G : MaximumMatching.Graph V} {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State V}
  {F : MaximumMatching.BudForest V} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
  cut % 2 = 1 →
    MaximumMatching.AtMostShortestAugmenting M (cut + 2) →
      2 * cap ≤ cut + 3 →
        MaximumMatching.Search.LowerBlossomRepresentation M cut s F →
          ∀ (u v : V),
            MaximumMatching.Bridge M u v →
              MaximumMatching.edgeTenacity M u v = some (cut + 2) →
                (∃ k, s.minLabel u = some k) →
                  (∃ k, s.minLabel v = some k) →
                    ∀ (p q : MaximumMatching.DDFS.Path (MaximumMatching.Search.predecessorGraph s F h)),
                      p.ToBottom (F.root u) →
                        q.ToBottom (F.root v) →
                          p.Disjoint q →
                            ∃ z,
                              z.Augmenting ∧
                                z.length = cut + 2 ∧
                                  z.ContainsEdge u v ∧
                                    ∀ (r : MaximumMatching.AltPath M), r.Augmenting → z.length ≤ r.length
@MaximumMatching.DDFS.ColoredTrees.bottom_linkage : ∀ {n : Nat} {H : MaximumMatching.DDFS.LayeredGraph (Fin n)}
  {S : Fin n → Prop} {r g b : Fin n} (T : MaximumMatching.DDFS.ColoredTrees H S r g b),
  MaximumMatching.DDFS.ReachBottom H →
    ∀ (v : Fin n),
      S v →
        H.level b < H.level v →
          ∃ p q,
            p.last = v ∧
              H.level q.last = 0 ∧
                p.Disjoint q ∧
                  (p.first = r ∧ q.first = g ∧ T.color v = some false ∨
                    p.first = g ∧ q.first = r ∧ T.color v = some true)
@MaximumMatching.Search.BudGraphInvariant.colored_region_support : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State (Fin n)}
  {F : MaximumMatching.BudForest (Fin n)} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
