            MaximumMatching.edgeTenacity M (p.vertex ⟨↑I, ⋯⟩) (p.vertex ⟨↑I + 1, ⋯⟩) = some t → p.BFSHonest ⟨↑I, ⋯⟩
@MaximumMatching.ParitySegment.bridge_join_segment : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (a b : MaximumMatching.ParitySegment M),
  (∀ (i : Fin (b.length + 1)) (j : Fin (a.length + 1)), b.vertex i ≠ a.vertex j) →
    a.phase % 2 = b.phase % 2 →
      G.Adj b.first a.first →
        (M.mate b.first = some a.first ↔ (b.phase + 1) % 2 = 1) →
          ∃ z,
            z.first = b.last ∧
              z.last = a.last ∧
                z.length = b.length + 1 + a.length ∧
                  z.phase = b.phase + b.length + 1 ∧
                    (∀ (w : V), z.Contains w → a.Contains w ∨ b.Contains w) ∧
                      ∃ i, z.vertex ⟨↑i, ⋯⟩ = b.first ∧ z.vertex ⟨↑i + 1, ⋯⟩ = a.first
@MaximumMatching.ParitySegment.bridge_join_relative : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (a b : MaximumMatching.ParitySegment M),
