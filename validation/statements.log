@MaximumMatching.Search.uncontracted_lower_representation_one : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} [inst : DecidableEq V] (s : MaximumMatching.Search.State V),
  (∀ (p : MaximumMatching.AltPath M), p.Augmenting → 1 < p.length) →
