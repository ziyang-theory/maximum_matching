@MaximumMatching.DDFS.BlossomWeightedMatching.realize : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} {H : MaximumMatching.DDFS.LayeredGraph V} {t : Nat}
  (W : MaximumMatching.DDFS.BlossomWeightedMatching M H t) (q : MaximumMatching.DDFS.Path H),
  (∀ (v : V), q.Contains v → MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M v)) →
    ∃ s,
      s.first = q.first ∧
        s.last = q.last ∧
          s.length = W.weight q ∧
            s.phase % 2 = W.phase q.first % 2 ∧
              (s.phase + s.length) % 2 = W.phase q.last % 2 ∧
                ∀ (v : V), s.Contains v → MaximumMatching.BlossomHull M t q.Contains v
@MaximumMatching.DDFS.BlossomWeightedMatching.realize_disjoint : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} {H : MaximumMatching.DDFS.LayeredGraph V} {t : Nat}
  (W : MaximumMatching.DDFS.BlossomWeightedMatching M H t) (p q : MaximumMatching.DDFS.Path H),
  (∀ (v : V), p.Contains v → MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M v)) →
    (∀ (v : V), q.Contains v → MaximumMatching.levelLT (some t) (MaximumMatching.tenacity M v)) →
      p.Disjoint q →
        ∃ s r,
          s.first = p.first ∧
            s.last = p.last ∧
              s.length = W.weight p ∧
                r.first = q.first ∧
                  r.last = q.last ∧
                    r.length = W.weight q ∧
                      s.phase % 2 = W.phase p.first % 2 ∧
                        r.phase % 2 = W.phase q.first % 2 ∧
                          ∀ (i : Fin (s.length + 1)) (j : Fin (r.length + 1)), s.vertex i ≠ r.vertex j
