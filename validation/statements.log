@MaximumMatching.DDFS.path_of_consecutive_indices : ∀ {V : Type} {H : MaximumMatching.DDFS.LayeredGraph V} {L : Nat}
  (x : Fin (L + 1) → V) (P : Fin (L + 1) → Prop) (A B : Fin (L + 1)),
  ↑A ≤ ↑B →
    P A →
      P B →
        (∀ (I J : Fin (L + 1)),
            ↑A ≤ ↑I →
              ↑I < ↑J → ↑J ≤ ↑B → P I → P J → (∀ (K : Fin (L + 1)), ↑I < ↑K → ↑K < ↑J → ¬P K) → H.Edge (x I) (x J)) →
          ∃ p,
            p.first = x A ∧
              p.last = x B ∧ p.length ≤ ↑B - ↑A ∧ ∀ (v : V), p.Contains v ↔ ∃ I, ↑A ≤ ↑I ∧ ↑I ≤ ↑B ∧ P I ∧ x I = v
@MaximumMatching.DDFS.path_of_reverse_consecutive_indices : ∀ {V : Type} {H : MaximumMatching.DDFS.LayeredGraph V}
  {L : Nat} (x : Fin (L + 1) → V) (P : Fin (L + 1) → Prop) (A B : Fin (L + 1)),
