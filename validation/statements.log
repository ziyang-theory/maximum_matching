                    ∀ (b : Fin n) (S : Fin n → Prop)
                      (T :
                        MaximumMatching.DDFS.ColoredTrees (MaximumMatching.Search.predecessorGraph s F h) S (F.root u)
                          (F.root v) b),
                      (∀ (w : Fin n), S w ↔ MaximumMatching.DDFS.OnRootTo (F.root u) (F.root v) b w) →
                        ∀ (w : Fin n),
                          S w →
                            w ≠ b → MaximumMatching.tenacity M w = some (cut + 2) ∧ MaximumMatching.InSupport M u v w
@MaximumMatching.Search.BudGraphInvariant.colored_bottleneck_even : ∀ {n : Nat} {G : MaximumMatching.Graph (Fin n)}
  {M : MaximumMatching.Matching G} {cap cut : Nat} {s : MaximumMatching.Search.State (Fin n)}
  {F : MaximumMatching.BudForest (Fin n)} (h : MaximumMatching.Search.BudGraphInvariant M cap s F),
