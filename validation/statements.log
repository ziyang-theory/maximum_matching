                    (∀ (v : Fin n), v ∈ R.newRoots → (R.maxEvent i).fst.maxLabel v = MaximumMatching.maxlevel M v) ∧
                      ∀ (v : Fin n) (k : Nat), R.prior.maxLabel v = some k → (R.maxEvent i).fst.maxLabel v = some k
@MaximumMatching.tenacity_one_bridge_augmenting : ∀ {V : Type} {G : MaximumMatching.Graph V}
  {M : MaximumMatching.Matching G} (u v : V),
