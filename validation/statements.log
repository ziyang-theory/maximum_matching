            ↑A ≤ ↑I →
              ↑I < ↑J → ↑J ≤ ↑B → P I → P J → (∀ (K : Fin (L + 1)), ↑I < ↑K → ↑K < ↑J → ¬P K) → H.Edge (x J) (x I)) →
          ∃ p,
            p.first = x B ∧
              p.last = x A ∧ p.length ≤ ↑B - ↑A ∧ ∀ (v : V), p.Contains v ↔ ∃ I, ↑A ≤ ↑I ∧ ↑I ≤ ↑B ∧ P I ∧ x I = v
@MaximumMatching.DDFS.Path.map_eq_or_edge : ∀ {V W : Type} {H : MaximumMatching.DDFS.LayeredGraph V}
